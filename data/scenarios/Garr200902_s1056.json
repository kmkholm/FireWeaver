 "nl": [
  "Permit any TCP port from nvr to ntp-servers but deny FTP (TCP 21), SMB (TCP 445).",
  "Deny all traffic from ntp-servers to nvr (this overrides any public service).",
  "Block FTP (TCP 21), RDP (TCP 3389), SMB (TCP 445) from printers to guest-wifi; the rest of any TCP port between them is allowed.",
  "Make DNS over UDP 53 on engineering reachable from all internal zones.",
  "Deny all traffic from nvr to printers (this overrides any public service).",
  "Make HTTP (TCP 80) and HTTPS (TCP 443) on voip reachable from all internal zones.",
  "Allow guest-wifi to connect to nvr using LDAP (TCP 389) and RDP (TCP 3389) and NTP (UDP 123).",
  "Hosts in ntp-servers may reach printers over MySQL (TCP 3306) and SMB (TCP 445) and SNMP (UDP 161).",
  "Allow guest-wifi to connect to nvr using RTSP (TCP 554).",
  "nvr must accept SMB (TCP 445) and RDP (TCP 3389) and DNS over UDP 53 from voip.",
  "Make DNS over UDP 53 on printers reachable from all internal zones.",
  "ntp-servers must accept PostgreSQL (TCP 5432) and NTP (UDP 123) from guest-wifi.",
  "nvr must accept HTTPS (TCP 443) and LDAP (TCP 389) and SNMP (UDP 161) from ntp-servers.",
  "nvr offers HTTPS (TCP 443) to every zone.",
  "Allow printers to connect to guest-wifi using IMAP (TCP 143).",
  "Hosts in voip may reach engineering over SNMP (UDP 161).",
  "Allow ntp-servers to connect to nvr using HTTP (TCP 80) and RDP (TCP 3389) and PostgreSQL (TCP 5432).",
  "Allow guest-wifi to connect to nvr using RTSP (TCP 554) and NTP (UDP 123) and HTTPS (TCP 443).",
  "Apart from engineering on DNS over UDP 53; voip on DNS over UDP 53, all traffic originating in printers must be dropped.",
  "Allow engineering to connect to nvr using MySQL (TCP 3306) and SMB (TCP 445) and LDAP (TCP 389).",
  "Allow engineering to connect to nvr using LDAP (TCP 389).",
  "Hosts in nvr may reach ntp-servers over NTP (UDP 123).",
  "printers must accept PostgreSQL (TCP 5432) from voip.",
  "Allow voip to connect to ntp-servers using SNMP (UDP 161) and DNS over UDP 53 and syslog (UDP 514).",
  "Any zone may connect to printers over DNS over UDP 53.",
  "Hosts in nvr may reach printers over MySQL (TCP 3306) and HTTPS (TCP 443).",
  "Hosts in ntp-servers may reach voip over SMTP (TCP 25) and NTP (UDP 123).",
  "Hosts in nvr may reach ntp-servers over HTTP (TCP 80) and HTTPS (TCP 443) and PostgreSQL (TCP 5432).",
  "guest-wifi must accept SMTP (TCP 25) and SSH (TCP 22) from engineering.",
  "Allow engineering to connect to ntp-servers using PostgreSQL (TCP 5432) and RDP (TCP 3389) and SMTP (TCP 25).",
  "Make HTTPS (TCP 443) and NTP (UDP 123) on voip reachable from all internal zones.",
  "Any zone may connect to nvr over DNS over UDP 53."
 ],
