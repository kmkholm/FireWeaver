 "nl": [
  "mail must accept DNS over UDP 53 and IMAP (TCP 143) and LDAP (TCP 389) from ntp-servers.",
  "Allow database to connect to iot-sensors using RTSP (TCP 554) and NTP (UDP 123).",
  "Allow library to connect to mail using NTP (UDP 123) and RDP (TCP 3389) and SSH (TCP 22).",
  "Any zone may connect to dev-lab over DNS over UDP 53.",
  "Hosts in monitoring may reach edge-cache over NTP (UDP 123).",
  "dmz-web must accept SSH (TCP 22) and SMTP (TCP 25) and NTP (UDP 123) from monitoring.",
  "Allow library to connect to iot-sensors using HTTP (TCP 80) and HTTPS (TCP 443) and IMAP (TCP 143).",
  "Allow mail to connect to dns-servers using SMTP (TCP 25) and RDP (TCP 3389) and MySQL (TCP 3306).",
  "Allow admin to connect to vpn-users using PostgreSQL (TCP 5432).",
  "Restrict dmz-web so that its only permitted destinations are iot-sensors on NTP (UDP 123); mail on NTP (UDP 123); drop all other traffic it originates.",
  "dev-lab must never reach research, regardless of any other rule.",
  "Allow iot-sensors to connect to ntp-servers using LDAP (TCP 389).",
  "Make HTTPS (TCP 443) on vpn-users reachable from all internal zones.",
  "Block TFTP (UDP 69) from research to guest-wifi; the rest of any UDP port between them is allowed.",
  "Hosts in library may reach guest-wifi over RDP (TCP 3389) and SNMP (UDP 161) and IMAP (TCP 143)."
 ],
