 "nl": [
  "scada is isolated: it may only reach student-lab on syslog (UDP 514), and nothing else.",
  "Block SNMP (UDP 161) from edge-cache to student-lab; the rest of any UDP port between them is allowed.",
  "Allow edge-cache to connect to mail using IMAP (TCP 143) and SSH (TCP 22) and LDAP (TCP 389).",
  "Permit TCP ports 1024-65535 from partners to edge-cache but deny PostgreSQL (TCP 5432), MySQL (TCP 3306), RDP (TCP 3389).",
  "Hosts in backup may reach vpn-users over HTTPS (TCP 443) and HTTP (TCP 80) and syslog (UDP 514).",
  "Allow edge-cache to connect to scada using SMB (TCP 445) and NTP (UDP 123).",
  "scada offers HTTPS (TCP 443) and NTP (UDP 123) to every zone.",
  "Block SNMP (UDP 161), TFTP (UDP 69) from dmz-web to backup; the rest of any UDP port between them is allowed."
 ],
