        <mxCell id="n118" value="&lt;b&gt;Z3, full 5-tuple&lt;/b&gt; (src 32 b, dst 32 b, proto 8 b, port 16 b)&lt;br&gt;∀ &lt;i&gt;s, d&lt;/i&gt;, ∀ π ∈ ECMP(&lt;i&gt;s, d&lt;/i&gt;):&lt;br&gt;∧&lt;sub&gt;&lt;i&gt;r&lt;/i&gt;∈π&lt;/sub&gt; dev&lt;sub&gt;&lt;i&gt;r&lt;/i&gt;&lt;/sub&gt;(&lt;i&gt;h&lt;/i&gt;) ≡ Π(&lt;i&gt;h&lt;/i&gt;)&lt;br&gt;&lt;span style='font-size:12px'&gt;unsat ⇒ verified · sat ⇒ packet witness&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b3fa0;strokeWidth=1.2;fontSize=13;fontColor=#1b1b1b;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="604" y="768" width="251" height="114" as="geometry"/></mxCell>
