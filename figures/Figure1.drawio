        <mxCell id="n115" value="&lt;span style='font-family:Consolas;font-size:11px'&gt;*filter&lt;br&gt;:FORWARD ACCEPT&lt;br&gt;-A FORWARD -m conntrack ...&lt;br&gt;-A FORWARD -s 10.0.16.0/20&lt;br&gt;&amp;nbsp;&amp;nbsp;-d 10.0.66.0/25 -p tcp&lt;br&gt;&amp;nbsp;&amp;nbsp;--dport 5432 -j ACCEPT&lt;br&gt;...&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6b3fa0;strokeWidth=1.2;fontSize=11;fontColor=#1b1b1b;align=left;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="361" y="768" width="205" height="114" as="geometry"/></mxCell>
