        <mxCell id="n109" value="&lt;span style='color:#3a7bd5'&gt;━&lt;/span&gt; path π&lt;sub&gt;1&lt;/sub&gt; &amp;nbsp; &lt;span style='color:#e07a1f'&gt;┅&lt;/span&gt; path π&lt;sub&gt;2&lt;/sub&gt; (equal cost) &amp;nbsp; ▮ router load / &lt;i&gt;C&lt;sub&gt;r&lt;/sub&gt;&lt;/i&gt; &amp;nbsp; ■ placed block" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontColor=#1b1b1b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="357" y="679" width="471" height="23" as="geometry"/></mxCell>
        <mxCell id="n110" value="&lt;b&gt;min&lt;/b&gt; Σ&lt;sub&gt;&lt;i&gt;b,r&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;c&lt;sub&gt;b&lt;/sub&gt; x&lt;sub&gt;br&lt;/sub&gt;&lt;/i&gt; (1 + α &lt;i&gt;h&lt;sub&gt;br&lt;/sub&gt;&lt;/i&gt;)&lt;br&gt;&lt;br&gt;Σ&lt;sub&gt;&lt;i&gt;r&lt;/i&gt;∈π&lt;/sub&gt; &lt;i&gt;x&lt;sub&gt;br&lt;/sub&gt;&lt;/i&gt; ≥ 1 &amp;nbsp; ∀ π ∈ ECMP(&lt;i&gt;b&lt;/i&gt;)&lt;br&gt;Σ&lt;sub&gt;&lt;i&gt;b&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;c&lt;sub&gt;b&lt;/sub&gt; x&lt;sub&gt;br&lt;/sub&gt;&lt;/i&gt; ≤ &lt;i&gt;C&lt;sub&gt;r&lt;/sub&gt;&lt;/i&gt; &amp;nbsp; ∀ &lt;i&gt;r&lt;/i&gt;&lt;br&gt;&lt;i&gt;x&lt;sub&gt;br&lt;/sub&gt;&lt;/i&gt; ∈ {0, 1}&lt;br&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#5f6b7a'&gt;every equal-cost path crosses a holder;&lt;br&gt;per-router entry budget; early drop (&lt;i&gt;h&lt;/i&gt; = hop index)&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.2;fontSize=15;fontColor=#1b1b1b;align=center;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="836" y="426" width="277" height="228" as="geometry"/></mxCell>
